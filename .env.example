# Copy to .env and supply values matching your initialized local database and Keycloak volumes.
# Changing these values does not reset credentials stored in existing volumes.
AUTH_DB_PASSWORD=replace-with-auth-database-password
TRANSACTION_DB_PASSWORD=replace-with-transaction-database-owner-password
BANKING_DB_USERNAME=banking_local
BANKING_DB_PASSWORD=replace-with-banking-local-role-password
KEYCLOAK_CLIENT_SECRET=replace-with-banking-auth-service-client-secret
KEYCLOAK_ADMIN_USERNAME=keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-keycloak-admin-password
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KAFKA_CLUSTER_ID=replace-with-existing-cluster-id
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173
