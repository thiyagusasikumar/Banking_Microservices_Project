# Copy this file to .env on each teammate's machine.
# Replace TEAM_SERVER_IP with the private IPv4 address of the machine
# that runs docker compose. Do not commit the copied .env file.

KEYCLOAK_SERVER_URL=http://TEAM_SERVER_IP:8080
AUTH_DB_URL=jdbc:postgresql://TEAM_SERVER_IP:5433/auth_db
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=auth_password
KEYCLOAK_REALM=banking-service
KEYCLOAK_CLIENT_ID=banking-auth-service
KEYCLOAK_CLIENT_SECRET=replace-with-the-shared-development-client-secret
