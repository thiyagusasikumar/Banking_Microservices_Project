{
  "info": {
    "name": "Banking Application - Account Service",
    "description": "Thirteen requests matching AccountController and AccountLifecycleController. Run Create Account first to capture accountId and accountNumber. Lifecycle order: activate, freeze, unfreeze, close, status-history. Current me uses customerId query parameter. Search filters apply only when both status and type are supplied.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "accountId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "accountNumber",
      "value": "ACC123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Create Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts"
          ]
        },
        "description": "Creates an INR savings account. Captures accountId and accountNumber for later requests.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": {{customerId}},\n  \"accountType\": \"SAVINGS\",\n  \"currency\": \"INR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Account created\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "    const account = pm.response.json();",
              "    if (account.id !== undefined) pm.collectionVariables.set(\"accountId\", String(account.id));",
              "    if (account.accountNumber) pm.collectionVariables.set(\"accountNumber\", account.accountNumber);",
              "}"
            ]
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "02 - Get Account by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}"
          ]
        },
        "description": "Retrieves the selected account by its accountId."
      },
      "response": [],
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Expected success status\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "03 - Get Account by Number",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/by-number/{{accountNumber}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "by-number",
            "{{accountNumber}}"
          ]
        },
        "description": "Uses accountNumber captured by Create Account."
      },
      "response": [],
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Expected success status\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "04 - Get My Accounts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/me?customerId={{customerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "me"
          ],
          "query": [
            {
              "value": "{{customerId}}",
              "key": "customerId"
            }
          ]
        },
        "description": "Current implementation requires customerId as a query parameter; it does not derive it from authentication."
      },
      "response": [],
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Expected success status\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "05 - Get Accounts by Customer ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/customer/{{customerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "customer",
            "{{customerId}}"
          ]
        },
        "description": "Returns accounts for the selected customer."
      },
      "response": [],
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Expected success status\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "06 - Search Accounts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts?page=0&size=20&status=ACTIVE&type=SAVINGS",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts"
          ],
          "query": [
            {
              "value": "0",
              "key": "page"
            },
            {
              "value": "20",
              "key": "size"
            },
            {
              "value": "ACTIVE",
              "key": "status"
            },
            {
              "value": "SAVINGS",
              "key": "type"
            }
          ]
        },
        "description": "Returns a paginated result. Supply both status and type for filtering; current service ignores a single filter. Remove both filters for an unfiltered page."
      },
      "response": [],
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Expected success status\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "07 - Patch Account Type",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}"
          ]
        },
        "description": "Updates only accountType. Current controller does not pass currency to the service.",
        "body": {
          "raw": "{\n  \"accountType\": \"CURRENT\"\n}",
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Expected success status\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "08 - Get Account Balance",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/balance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}",
            "balance"
          ]
        },
        "description": "Returns the account balance."
      },
      "response": [],
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Expected success status\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
