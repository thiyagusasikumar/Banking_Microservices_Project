            "accounts",
            "{{accountId}}",
            "unfreeze"
          ]
        },
        "description": "Updates the account status and saves a history entry. Uses accountId captured by Create Account.",
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"reason\": \"Account review completed\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
