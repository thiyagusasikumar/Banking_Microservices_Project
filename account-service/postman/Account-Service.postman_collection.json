            "v1",
            "accounts",
            "{{accountId}}",
            "activate"
          ]
        },
        "description": "Updates the account status and saves a history entry. Uses accountId captured by Create Account.",
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"reason\": \"Account activation requested\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
