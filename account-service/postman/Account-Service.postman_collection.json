{
  "info": {
    "name": "Banking Application - Account Service",
    "description": "Eight requests matching the current AccountController at /api/v1/accounts. Run in order; create captures accountId automatically. Delete runs last and currently returns HTTP 200.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "accountId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Create Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts"
          ]
        },
        "description": "Creates an account and saves the returned ID into the collection accountId variable.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": {{customerId}},\n  \"accountType\": \"SAVINGS\",\n  \"currency\": \"INR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Account created\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "    const account = pm.response.json();",
              "    if (account.id !== undefined) pm.collectionVariables.set(\"accountId\", String(account.id));",
              "}"
            ]
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "02 - Get Account by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}"
          ]
        },
        "description": "Retrieves the selected account."
      },
      "response": []
    },
    {
      "name": "03 - Get All Accounts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/getAll",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "getAll"
          ]
        },
        "description": "Retrieves all accounts using the existing controller route."
      },
      "response": []
    },
    {
      "name": "04 - Get Account Balance",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/balance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}",
            "balance"
          ]
        },
        "description": "Retrieves the selected account balance."
      },
      "response": []
    },
    {
      "name": "05 - Get Accounts by Customer ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/customer/{{customerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "customer",
            "{{customerId}}"
          ]
        },
        "description": "Retrieves accounts for the selected customer."
      },
      "response": []
    },
    {
      "name": "06 - Update Account Status",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/status?status=ACTIVE",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}",
            "status"
          ],
          "query": [
            {
              "key": "status",
              "value": "ACTIVE"
            }
          ]
        },
        "description": "Update status. Use ACTIVE, BLOCKED or CLOSED. No body required."
      },
      "response": []
    },
    {
      "name": "07 - Update Account",
      "request": {
        "body": {
          "raw": "{\n  \"accountType\": \"CURRENT\",\n  \"currency\": \"INR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "mode": "raw"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "method": "PUT",
        "description": "Updates accountType and currency. Supply both fields because the current service replaces both values."
      },
      "response": []
    },
    {
      "name": "08 - Delete Account",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}"
          ]
        },
        "description": "Physically deletes the selected zero-balance account. Run last. Current controller returns the service success message."
      },
      "response": []
    }
  ]
}
