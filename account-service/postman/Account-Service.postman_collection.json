{
  "info": {
    "name": "Banking Application - Account Service",
    "description": "One request for each of the seven endpoints in AccountController.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "accountId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Create Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts"
          ]
        },
        "description": "Create an account. Set accountId manually to the returned ID for other requests.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": {{customerId}},\n  \"accountType\": \"SAVINGS\",\n  \"currency\": \"INR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "02 - Get Account by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts",
            "{{accountId}}"
          ]
        },
        "description": "Retrieves the selected account."
      },
      "response": []
    },
    {
      "name": "03 - Get All Accounts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/accounts/getAll",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts",
            "getAll"
          ]
        },
        "description": "Retrieves all accounts using the existing controller route."
      },
      "response": []
    },
    {
      "name": "04 - Get Account Balance",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/balance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts",
            "{{accountId}}",
            "balance"
          ]
        },
        "description": "Retrieves the selected account balance."
      },
      "response": []
    },
    {
      "name": "05 - Get Accounts by Customer ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/accounts/customer/{{customerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts",
            "customer",
            "{{customerId}}"
          ]
        },
        "description": "Retrieves accounts for the selected customer."
      },
      "response": []
    },
    {
      "name": "06 - Update Account Status",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/status?status=ACTIVE",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts",
            "{{accountId}}",
            "status"
          ],
          "query": [
            {
              "key": "status",
              "value": "ACTIVE"
            }
          ]
        },
        "description": "Update status. Use ACTIVE, BLOCKED or CLOSED. No body required."
      },
      "response": []
    },
    {
      "name": "07 - Delete Account",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts",
            "{{accountId}}"
          ]
        },
        "description": "Physically deletes the selected zero-balance account. Run last. Current controller returns the service success message."
      },
      "response": []
    }
  ]
}