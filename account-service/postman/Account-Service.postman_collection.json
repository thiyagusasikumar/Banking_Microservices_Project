{
  "info": {
    "name": "Banking Application - Account Service",
    "description": "Requests for AccountController and AccountLifecycleController. Set accessToken to the accessToken returned by auth-service login. Run Create Account first to capture accountId and accountNumber. The authenticated customer's ID is read from the token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "accountId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountNumber",
      "value": "ACC123",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Create Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts"
          ]
        },
        "description": "Creates an INR savings account for the authenticated customer. customerId is read from the bearer token. Captures accountId and accountNumber for later requests.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountType\": \"SAVINGS\",\n  \"currency\": \"INR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Account created\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "    const account = pm.response.json();",
              "    if (account.id !== undefined) pm.collectionVariables.set(\"accountId\", String(account.id));",
              "    if (account.accountNumber) pm.collectionVariables.set(\"accountNumber\", account.accountNumber);",
              "}"
            ]
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "02 - Get Account by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}"
          ]
        },
        "description": "Retrieves the selected account by its accountId."
      },
      "response": [],
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Expected success status\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "03 - Get Account by Number",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/by-number/{{accountNumber}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "by-number",
            "{{accountNumber}}"
          ]
        },
        "description": "Uses accountNumber captured by Create Account."
      },
      "response": [],
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Expected success status\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "04 - Get Current Customer ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/me/customer-id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "me",
            "customer-id"
          ]
        },
        "description": "Returns customerId from the authenticated access token."
      },
      "response": []
    },
    {
      "name": "05 - Get My Accounts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "me"
          ],
          "query": []
        },
        "description": "Returns accounts belonging to the authenticated customer, using customer_id from the bearer token."
      },
      "response": [],
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Expected success status\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "06 - Get Accounts by Customer ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/customer/{{customerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "customer",
            "{{customerId}}"
          ]
        },
        "description": "Returns accounts for the selected customer."
      },
      "response": [],
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Expected success status\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "07 - Search Accounts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts?page=0&size=20&status=ACTIVE&type=SAVINGS",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts"
          ],
          "query": [
            {
              "value": "0",
              "key": "page"
            },
            {
              "value": "20",
              "key": "size"
            },
            {
              "value": "ACTIVE",
              "key": "status"
            },
            {
              "value": "SAVINGS",
              "key": "type"
            }
          ]
        },
        "description": "Returns a paginated result. Supply both status and type for filtering; current service ignores a single filter. Remove both filters for an unfiltered page."
      },
      "response": [],
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Expected success status\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "08 - Patch Account Type",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}"
          ]
        },
        "description": "Updates only accountType. Current controller does not pass currency to the service.",
        "body": {
          "raw": "{\n  \"accountType\": \"CURRENT\"\n}",
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Expected success status\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "09 - Get Account Balance",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/balance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}",
            "balance"
          ]
        },
        "description": "Returns the account balance."
      },
      "response": [],
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Expected success status\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "10 - Activate Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/activate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}",
            "activate"
          ]
        },
        "description": "Updates the account status and saves a history entry. Uses accountId captured by Create Account.",
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"reason\": \"Account activation requested\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "11 - Freeze Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/freeze",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}",
            "freeze"
          ]
        },
        "description": "Updates the account status and saves a history entry. Uses accountId captured by Create Account.",
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"reason\": \"Account review requested\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
